# Supabase session pooler URI. Use port 5432 and require SSL.
# The API accepts postgresql:// and connects with the psycopg driver.
# Better Auth uses the same value with node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters

# Public origin of the auth routes during local Vite development.
# Docker Compose publishes the app on port 8080 and sets its own BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated browser origins allowed to call Better Auth.
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional one-time bootstrap. Do not commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
