# Supabase session pooler URI. Use port 5432 and require SSL.
# The API accepts postgresql:// and connects with the psycopg driver.
# Better Auth uses the same value with node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters

# Public origin of the auth routes during local Vite development.
# Docker Compose publishes the app on port 8080 and sets its own BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated browser origins allowed to call Better Auth.
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional. Leave these unset to use the defaults.
# A local API talks to Ollama at http://127.0.0.1:11434 and Qdrant at http://127.0.0.1:6333.
# Compose uses http://ollama:11434 and http://qdrant:6333 unless you export a value.
# To call Ollama on the host from Compose instead of the bundled service:
# EMBEDDING_BASE_URL=http://host.docker.internal:11434
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSION=1024
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=documents

# Grok, through the OpenAI-compatible xAI API. Do not commit a real key.
# XAI_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7

# Compose reindexes existing documents for BM25 on startup. Leave this unset
# for a local API unless you want that rebuild every time the process starts.
# HYBRID_BACKFILL=1

# Optional one-time bootstrap. Do not commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
